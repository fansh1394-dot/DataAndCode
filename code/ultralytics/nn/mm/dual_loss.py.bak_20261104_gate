DEFAULT_BRANCH_WEIGHTS = {"rgb": 1.0, "ir": 1.0, "fuse": 1.0, "fuse_ir": 1.0}
#: 各分支标签来源：rgb→RGB 标签；ir→IR 标签；fuse→RGB 标签（融合主坐标系为 RGB）
